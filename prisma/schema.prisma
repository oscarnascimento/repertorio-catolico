datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Acervo geral de músicas cadastradas
model Song {
  id        String      @id @default(uuid())
  title     String
  artist    String?
  youtube   String?     // Link do YouTube
  createdAt DateTime    @default(now())
  events    EventSong[]
}

// Evento / Celebração (ex: "Adoração 25/09")
model Event {
  id        String      @id @default(uuid())
  title     String
  notes     String?     // Observação geral da celebração
  createdAt DateTime    @default(now())
  songs     EventSong[]
}

// Tabela relacional com estado de seleção, ordenação e comentários
model EventSong {
  id        String   @id @default(uuid())
  eventId   String
  songId    String
  selected  Boolean  @default(false) // Se o diácono marcou
  order     Int      @default(0)     // Posição na lista
  notes     String?  // Comentário/observação específico para esta música

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([eventId, songId])
}
